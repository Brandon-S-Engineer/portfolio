{
  "manifest_version": 3,
  "name": "Apple Price Catcher",
  "version": "0.8.0",
  "description": "Captura pasiva de listings (Facebook Marketplace + grupos) y de vacantes de Indeed hacia el CRM.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.indeed.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/groups/*"
      ],
      "js": [
        "content/observer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content/mp-selectors.js",
        "content/mp-extract.js",
        "content/marketplace.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": [
        "content/indeed.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Apple Price Catcher"
  },
  "options_page": "options/options.html"
}
